<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS refuses microphone access outright unless the app declares why it wants
  it, and the refusal is silent from the app's point of view: the device simply
  never produces samples. Without this key the intercom would install, launch,
  discover peers, and never transmit — the exact class of failure the rewrite
  exists to delete.

  The string is shown to the user in the permission prompt, so it is written for
  them rather than for us.
-->
<plist version="1.0">
  <dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>Zetta Com uses your microphone to talk to other computers on your network while you hold the talk key.</string>
  </dict>
</plist>
